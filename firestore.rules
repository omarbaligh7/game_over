rules_version = '2';

// ============================================
// GAME OVER — Firestore Security Rules
// ============================================
// كل مستخدم مسجّل دخوله عبر Firebase Authentication عنده uid ثابت
// وموثّق من سيرفرات Firebase نفسها (مينفعش حد يزوّره من الـ client).
// القاعدة الأساسية هنا: كل مستخدم يقدر يقرا/يكتب بياناته هو بس.
// ============================================

service cloud.firestore {
  match /databases/{database}/documents {

    // بيانات كل مستخدم (الألعاب، الحسابات، الأرشيف، سجل المبيعات)
    // Document ID = uid بتاع المستخدم في Firebase Authentication
    match /userData/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // أي collection تانية غير معرّفة هنا: ممنوعة تمامًا افتراضيًا
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
